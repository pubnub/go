{
  ".pubnub.yml": [
    { "pattern": "^version: (.+)$", "cleared": false },
    { "pattern": "\/releases\/tag\/(v?(\\d+\\.?){2,}([a-zA-Z-]+(\\.?\\d+)?)?)", "cleared": false }
  ],
  "pubnub.go": [
    { "pattern": "^[ \\t]*Version = \"(.*)\"", "cleared": true }
  ],
  "VERSION": [
  { "pattern": "^(v?(\\d+\\.?){2,}([a-zA-Z0-9-]+(\\.?\\d+)?)?)$", "cleared": true }
]
}
